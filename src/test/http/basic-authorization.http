# Author: Oleksii Hnidan
# Project: web-security26 | Lab: 3 | File: basic-authorization.http

@baseUrl = http://localhost:8080/api/v1/tracks

### 1. GET all tracks with valid credentials
GET {{baseUrl}}
Authorization: Basic admin admin
Accept: application/json

### 2. GET all tracks with invalid credentials
GET {{baseUrl}}
Authorization: Basic admin wrong-password
Accept: application/json

### 3. GET track 1 with valid credentials
GET {{baseUrl}}/1
Authorization: Basic admin admin
Accept: application/json

### 4. GET track 1 with invalid credentials
GET {{baseUrl}}/1
Authorization: Basic admin wrong-password
Accept: application/json

### 5. POST a track with valid credentials
POST {{baseUrl}}
Authorization: Basic admin admin
Content-Type: application/json
Accept: application/json

{
  "title": "Be Quiet and Drive (Far Away)",
  "artist": "Deftones",
  "album": "Around the Fur",
  "durationSeconds": 300
}

### 6. POST a track with invalid credentials
POST {{baseUrl}}
Authorization: Basic admin wrong-password
Content-Type: application/json
Accept: application/json

{
  "title": "Be Quiet and Drive (Far Away)",
  "artist": "Deftones",
  "album": "Around the Fur",
  "durationSeconds": 300
}

### 7. PUT track 4 with valid credentials
PUT {{baseUrl}}/4
Authorization: Basic admin admin
Content-Type: application/json
Accept: application/json

{
  "title": "Be Quiet and Drive (Far Away)",
  "artist": "Deftones",
  "album": "Around the Fur",
  "durationSeconds": 301
}

### 8. PUT track 4 with invalid credentials
PUT {{baseUrl}}/4
Authorization: Basic admin wrong-password
Content-Type: application/json
Accept: application/json

{
  "title": "Be Quiet and Drive (Far Away)",
  "artist": "Deftones",
  "album": "Around the Fur",
  "durationSeconds": 301
}

### 9. DELETE track 4 with valid credentials
DELETE {{baseUrl}}/4
Authorization: Basic admin admin
Accept: application/json

### 10. DELETE track 4 with invalid credentials
DELETE {{baseUrl}}/4
Authorization: Basic admin wrong-password
Accept: application/json
